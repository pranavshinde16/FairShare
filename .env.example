# Copy to .env for local development: cp .env.example .env
# Never commit .env. This repository is public.

NODE_ENV=development
PORT=3000

# Matches docker-compose.yml (host port 5433).
DATABASE_URL=postgres://fairshare:fairshare@localhost:5433/fairshare

# Optional: the connection the pre-deploy migration uses (owner role, unpooled). Defaults to
# DATABASE_URL, which is right locally. See docs/deploy-staging.md for hosted Postgres.
MIGRATION_DATABASE_URL=

# Integration tests create throwaway databases on this server (see packages/db/src/testing).
TEST_DATABASE_URL=postgres://fairshare:fairshare@localhost:5433/fairshare_test

# ---- Sign-in -----------------------------------------------------------------------------------

# Where you open the app. With `pnpm dev` that's Vite, which is also the default.
APP_URL=http://localhost:5173

# Signs session cookies. Required: any random string of 32+ characters. Generate one with
#   openssl rand -base64 32
AUTH_SECRET=

# Google sign-in (optional). From a Google Cloud OAuth client (docs/deploy-staging.md). To use it
# locally, add http://localhost:5173/api/auth/callback/google to the client's redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign-in codes go by email. Locally they land in Mailpit (docker-compose.yml): open
# http://localhost:8025 to read them. In production, Resend: RESEND_API_KEY plus an EMAIL_FROM
# address on a domain verified in Resend.
MAILPIT_URL=http://localhost:8025
RESEND_API_KEY=
EMAIL_FROM=

# The request header holding the client's IP, for per-IP sign-in limits. Defaults to x-real-ip
# (Railway). Behind Cloudflare: cf-connecting-ip.
CLIENT_IP_HEADERS=

# ---- Typed entry with an AI model (optional) ------------------------------------------------------

# Sentences the rule-based parser can't fully read ("dinner ka 2400 maine diya") go to the primary
# provider, then the fallback; both speak the OpenAI /chat/completions API. Without
# AI_PRIMARY_API_KEY they fall back to the form, with the sentence as the description. Model names
# change: when one is retired, change the variable and run `pnpm --filter @fairshare/api
# eval:parse` (docs/operations.md, "Typed entry's AI providers").
AI_ENABLED=true
AI_TIMEOUT_MS=8000
# Spend per UTC day in US dollar micros before no provider is called (unset: no limit; free tiers
# cost nothing, so the token caps below are what protect them).
AI_DAILY_BUDGET_MICROS=
# Groq (console.groq.com → API keys). Turn on Zero Data Retention in its Data Controls.
AI_PRIMARY_PROVIDER=groq
AI_PRIMARY_BASE_URL=https://api.groq.com/openai/v1
AI_PRIMARY_API_KEY=
AI_PRIMARY_TEXT_MODEL=openai/gpt-oss-120b
AI_PRIMARY_SCHEMA_MODE=strict
AI_PRIMARY_EXTRA_PARAMS={"reasoning_effort":"low"}
# Stay under the free tier's tokens per day (check the console's limits page for the model).
AI_PRIMARY_DAILY_TOKENS=160000
# US dollars per million input and output tokens, e.g. 0.15,0.60, once on a paid plan.
AI_PRIMARY_PRICE=
# Cloudflare Workers AI, used when Groq fails or is over its cap (dash.cloudflare.com → AI →
# Workers AI; the URL holds your account ID; the token needs Workers AI read and edit).
AI_FALLBACK_PROVIDER=cloudflare
AI_FALLBACK_BASE_URL=
AI_FALLBACK_API_KEY=
AI_FALLBACK_TEXT_MODEL=@cf/meta/llama-4-scout-17b-16e-instruct
AI_FALLBACK_SCHEMA_MODE=json_object
AI_FALLBACK_EXTRA_PARAMS=
AI_FALLBACK_DAILY_TOKENS=
AI_FALLBACK_PRICE=

# ---- Operations ----------------------------------------------------------------------------------

# Log level: fatal, error, warn, info (default), debug, trace or silent.
# In development the logs are pretty-printed; everywhere else they are JSON lines.
LOG_LEVEL=info

# Error tracking (optional). Without a DSN nothing is sent. On staging set SENTRY_ENVIRONMENT=staging
# and SENTRY_RELEASE to the git commit.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=

# Serve the built web app from the API, as the Docker image does. Leave unset with `pnpm dev`,
# where Vite serves the app. To try production mode locally:
#   pnpm build && WEB_DIST_DIR=../web/dist pnpm --filter @fairshare/api start
WEB_DIST_DIR=

# Browser settings are read by Vite at build time, not from this file: put them in
# apps/web/.env.local for local builds, or pass them as Docker build arguments
# (docker build --build-arg VITE_SENTRY_DSN=...). They are public, so never put a secret there.
#   VITE_SENTRY_DSN=
#   VITE_SENTRY_ENVIRONMENT=
#   VITE_CONTACT_EMAIL=        (privacy requests; shown on /privacy and /terms)
