# Copy to .env for local development: cp .env.example .env
# Never commit .env. This repository is public.

NODE_ENV=development
PORT=3000

# Matches docker-compose.yml (host port 5433).
DATABASE_URL=postgres://fairshare:fairshare@localhost:5433/fairshare

# Optional: the connection the pre-deploy migration uses (owner role, unpooled). Defaults to
# DATABASE_URL, which is right locally. See docs/deploy-staging.md for hosted Postgres.
MIGRATION_DATABASE_URL=

# Integration tests create throwaway databases on this server (see packages/db/src/testing).
TEST_DATABASE_URL=postgres://fairshare:fairshare@localhost:5433/fairshare_test

# Log level: fatal, error, warn, info (default), debug, trace or silent.
# In development the logs are pretty-printed; everywhere else they are JSON lines.
LOG_LEVEL=info

# Error tracking (optional). Without a DSN nothing is sent. On staging set SENTRY_ENVIRONMENT=staging
# and SENTRY_RELEASE to the git commit.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=

# Serve the built web app from the API, as the Docker image does. Leave unset with `pnpm dev`,
# where Vite serves the app. To try production mode locally:
#   pnpm build && WEB_DIST_DIR=../web/dist pnpm --filter @fairshare/api start
WEB_DIST_DIR=

# Browser settings are read by Vite at build time, not from this file: put them in
# apps/web/.env.local for local builds, or pass them as Docker build arguments
# (docker build --build-arg VITE_SENTRY_DSN=...). They are public, so never put a secret there.
#   VITE_SENTRY_DSN=
#   VITE_SENTRY_ENVIRONMENT=
