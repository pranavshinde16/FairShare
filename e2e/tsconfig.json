{
  "extends": "@fairshare/config/tsconfig/node.json",
  "compilerOptions": {
    // Code passed to page.evaluate() and addInitScript() runs in the browser.
    "lib": ["ES2023", "DOM"],
    // scripts/ run under Node's type stripping, which needs the .ts in relative imports.
    "allowImportingTsExtensions": true
  },
  "include": ["tests", "scripts", "playwright.config.ts"]
}
